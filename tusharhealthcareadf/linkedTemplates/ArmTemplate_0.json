{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "tusharhealthcareadf"
		},
		"ls_hc_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_hc_adls'"
		},
		"ls_hc_azuresql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_hc_azuresql'"
		},
		"ls_hc_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcaretusharsa.dfs.core.windows.net/"
		},
		"ls_hc_azuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tusharserverforhc.database.windows.net"
		},
		"ls_hc_azuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "healthcare_db11"
		},
		"ls_hc_azuresql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "tusharserver"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_hc_adls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_hc_adls_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_hc_adls_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_hc_azuresql')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_hc_azuresql_properties_typeProperties_server')]",
					"database": "[parameters('ls_hc_azuresql_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_hc_azuresql_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_hc_azuresql_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_hc_parquet')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_hc_adls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folder_path": {
						"type": "string"
					},
					"file_path": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().file_path",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().folder_path",
							"type": "Expression"
						},
						"fileSystem": "landing"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_hc_adls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_hc_sql')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_hc_azuresql",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_hc_azuresql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/hc_pipeline_azuresql_to_adls')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "GetWindow",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT CONVERT(varchar(23), SYSUTCDATETIME(), 126) AS high_watermark;",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_hc_sql",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "GetTables",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "GetWindow",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT\n    table_name,\n    CASE\n        WHEN last_success IS NULL THEN 'FULL'\n        ELSE load_mode\n    END AS load_mode,\n    CONVERT(\n        varchar(23),\n        COALESCE(\n            last_success,\n            CONVERT(datetime2(3),'1900-01-01',126)\n        ),\n        126\n    ) AS last_success\nFROM control_schema.source_config\nORDER BY table_name;\n",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_hc_sql",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "CopyTables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "GetTables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('GetTables').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "CopySource",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@if(\n    equals(item().load_mode, 'FULL'),\n    concat(\n        'SELECT * FROM dbo.[', item().table_name, ']'\n    ),\n    concat(\n        'SELECT * FROM dbo.[', item().table_name, '] ',\n        'WHERE updated_at >= CONVERT(datetime2(3),''', item().last_success, ''',126) ',\n        'AND updated_at <= CONVERT(datetime2(3),''', activity('GetWindow').output.firstRow.high_watermark, ''',126)'\n    )\n)\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_hc_sql",
											"type": "DatasetReference",
											"parameters": {}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_hc_parquet",
											"type": "DatasetReference",
											"parameters": {
												"folder_path": {
													"value": "@concat('healthcare/sql/',pipeline().RunId,'/',item().table_name)",
													"type": "Expression"
												},
												"file_path": {
													"value": "item().table_name",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "RecordExtract",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "CopySource",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[control_schema].[record_extract]",
										"storedProcedureParameters": {
											"batch_id": {
												"value": {
													"value": "@pipeline().RunId",
													"type": "Expression"
												},
												"type": "String"
											},
											"copied_rows": {
												"value": {
													"value": "@activity('CopySource').output.rowsCopied",
													"type": "Expression"
												},
												"type": "Int64"
											},
											"read_rows": {
												"value": {
													"value": "@activity('CopySource').output.rowsRead",
													"type": "Expression"
												},
												"type": "Int64"
											},
											"table_name": {
												"value": {
													"value": "@item().table_name",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "ls_hc_azuresql",
										"type": "LinkedServiceReference"
									}
								},
								{
									"name": "FailedExtract",
									"type": "SqlServerStoredProcedure",
									"state": "Inactive",
									"onInactiveMarkAs": "Succeeded",
									"dependsOn": [
										{
											"activity": "CopySource",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_hc_sql')]",
				"[concat(variables('factoryId'), '/datasets/ds_hc_parquet')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_hc_azuresql')]"
			]
		}
	]
}