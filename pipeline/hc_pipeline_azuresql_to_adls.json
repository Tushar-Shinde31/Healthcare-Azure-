{
	"name": "hc_pipeline_azuresql_to_adls",
	"properties": {
		"activities": [
			{
				"name": "GetWindow",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT CONVERT(varchar(23), SYSUTCDATETIME(), 126) AS high_watermark;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_hc_sql",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "GetTables",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "GetWindow",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    table_name,\n    CASE\n        WHEN last_success IS NULL THEN 'FULL'\n        ELSE load_mode\n    END AS load_mode,\n    CONVERT(\n        varchar(23),\n        COALESCE(\n            last_success,\n            CONVERT(datetime2(3),'1900-01-01',126)\n        ),\n        126\n    ) AS last_success\nFROM control_schema.source_config\nORDER BY table_name;\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_hc_sql",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "CopyTables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetTables').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CopySource",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@if(\n    equals(item().load_mode, 'FULL'),\n    concat(\n        'SELECT * FROM dbo.[', item().table_name, ']'\n    ),\n    concat(\n        'SELECT * FROM dbo.[', item().table_name, '] ',\n        'WHERE updated_at >= CONVERT(datetime2(3),''', item().last_success, ''',126) ',\n        'AND updated_at <= CONVERT(datetime2(3),''', activity('GetWindow').output.firstRow.high_watermark, ''',126)'\n    )\n)\n",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_hc_sql",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_hc_parquet",
									"type": "DatasetReference",
									"parameters": {
										"folder_path": {
											"value": "@concat('healthcare/sql/',pipeline().RunId,'/',item().table_name)",
											"type": "Expression"
										},
										"file_path": {
											"value": "item().table_name",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "RecordExtract",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CopySource",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[control_schema].[record_extract]",
								"storedProcedureParameters": {
									"batch_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"copied_rows": {
										"value": {
											"value": "@activity('CopySource').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"read_rows": {
										"value": {
											"value": "@activity('CopySource').output.rowsRead",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"table_name": {
										"value": {
											"value": "@item().table_name",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_hc_azuresql",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "FailedExtract",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CopySource",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[control_schema].[record_extract_failure]",
								"storedProcedureParameters": {
									"batch_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"copied_rows": {
										"value": {
											"value": "@activity('CopySource').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"error_message": {
										"value": {
											"value": "@activity('CopySource').error.message",
											"type": "Expression"
										},
										"type": "String"
									},
									"failed_activity": {
										"value": {
											"value": "CopySource",
											"type": "Expression"
										},
										"type": "String"
									},
									"read_rows": {
										"value": {
											"value": "@activity('CopySource').output.rowsRead",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"table_name": {
										"value": {
											"value": "@item().table_name",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_hc_azuresql",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "CommitBatch",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "LoadBronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control_schema].[commit_batch]",
					"storedProcedureParameters": {
						"batch_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"expected_tables": {
							"value": {
								"value": "@length(activity('GetTables').output.value)",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"high_watermark": {
							"value": {
								"value": "@activity('GetWindow').output.firstRow.high_watermark",
								"type": "Expression"
							},
							"type": "DateTime"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_hc_azuresql",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "GetBatchDetails",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "CopyTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT r.table_name, r.copied_rows, CASE WHEN c.last_success IS NULL THEN ''FULL'' ELSE c.load_mode END AS load_mode FROM control_schema.extract_runs r JOIN control_schema.source_config c ON c.table_name = r.table_name WHERE r.batch_id = ''', pipeline().RunId, ''' ORDER BY r.table_name;')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_hc_sql",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "LoadBronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "GetBatchDetails",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/atulkala96@gmail.com/setup_bronze_load"
				},
				"linkedServiceName": {
					"referenceName": "ls_azureadb",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": []
	}
}