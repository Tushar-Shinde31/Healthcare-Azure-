{
	"name": "hc_pipeline_azuresql_to_adls_copy1",
	"properties": {
		"activities": [
			{
				"name": "CommitBatch",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "LoadBronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control_schema].[commit_batch]",
					"storedProcedureParameters": {
						"batch_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"expected_tables": {
							"value": {
								"value": "@length(activity('GetTables').output.value)",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"high_watermark": {
							"value": {
								"value": "@activity('GetWindow').output.firstRow.high_watermark",
								"type": "Expression"
							},
							"type": "DateTime"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_hc_azuresql",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "GetBatchDetails",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT r.table_name, r.copied_rows, CASE WHEN c.last_success IS NULL THEN ''FULL'' ELSE c.load_mode END AS load_mode FROM control_schema.extract_runs r JOIN control_schema.source_config c ON c.table_name = r.table_name WHERE r.batch_id = ''', pipeline().RunId, ''' ORDER BY r.table_name;')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_hc_sql",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "LoadBronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "GetBatchDetails",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/atulkala96@gmail.com/setup_bronze_load"
				}
			}
		],
		"annotations": []
	}
}